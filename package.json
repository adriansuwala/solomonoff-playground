{
  "name": "solomonoff-playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An interactive playground for 'Self-Play Pretraining with Zero Data' (arXiv:2609.30063). Every claim is linked to its paper section.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && node scripts/build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "data:build": "python3 tools/build_data.py",
    "data:verify": "python3 tools/verify_data.py"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
